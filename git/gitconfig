  date = human # date format shown in logs
  decorate = true # show ref names in log output
  follow = true # follow renames for single-path log (NOTE: Git default is false)
  graphColors = red,green,yellow,blue,magenta,cyan # default --graph colour order
  showRoot = true # show the initial commit as a diff against the empty tree
  showSignature = false # verify on demand via `git log --show-signature`; true would slow + clutter every log
  mailmap = true # apply .mailmap to author/committer names

