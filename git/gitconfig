##
## User-level Git Configuration file
##

[add]
  ignoreErrors = true # make `git add` error not fatal

[advice]
  addEmbeddedRepo = true # advice on accidental repo nesting
  amWorkDir = true # show location of patch when `git am` fails
  commitBeforeMerge = true # advice on merge failure due to uncommitted changes
  detachedHead = true # advice how to create branch when in detached HEAD state
  ignoredHook = true # warn about ignored hook because it is not set as executable
  implicitIdentity = true # advice on how to set identity when none is set
  pushAlreadyExists = true # advice on bad push for not being able to fast-forward
  pushFetchFirst = true # advice to fetch when trying to push to a branch ahead
  pushNeedsForce = true # advice on how to force a push to be accepted
  pushNonFFCurrent = true # hints when push fails due to a non-fast-forward update
  pushNonFFMatching = true # hints when matching push fails due to a NFF update
  pushUpdateRejected = true # turn all push* advices on/off simultaneously
  resolveConflict = true # command advice on how to resolve conflicts
  rmHints = true # hints when `git rm` fails
  statusHints = true # hints on how to deal with files on `git status`
  statusUoption = true # advice to use `-u` option when `git status` is slow
  waitingForEditor = true # message while waiting for editor input from the user

[alias]
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit # decorated one-line graph
  dft = difftool --tool difftastic # structural (syntax-aware) diff via difftastic, when installed

[am]
  keepcr = true # do not remove \\r from lines ending with \\r\\n
  threeWay = true # fall back on 3-way merge if the patch does not apply cleanly

[apply]
  ignoreWhitespace = change # ignore changes in whitespace
  whitespace = fix # fix whitespace issues automatically

[blame]
  showRoot = false # do NOT treat root commits as boundaries (false = show them)
  blankBoundary = true # present a blank hash for boundary commits
  showEmail = true # show the author's email instead of the name
  # date # the format of the date shown (default unset - ISO)

[branch]
  autoSetupMerge = simple # track upstream only when local name matches the remote branch (default: true)
  autoSetupRebase = always # new branches rebase on `git pull` instead of merge (default: never)
  sort = -committerdate # `git branch` lists most-recently-committed first, not alphabetical

[browser "auto"]
  # cross-platform open: macOS `open`, Linux `xdg-open`, Windows `start` — first one found wins
  cmd = "sh -c 'for o in open xdg-open start; do command -v $o >/dev/null 2>&1 && exec $o \"$1\"; done' --"

[clean]
  requireForce = true # make `git clean` do nothing unless given -f, -i or -n

[color]
  # branch # colour in `git branch`. Overrides `ui` value (default auto)
  # diff # ANSI escape sequences in patches. Overrides `ui` value (default auto)
  # grep # colour matches. Overrides `ui` value (default auto)
  # interactive # colour interactive prompts. Overrides `ui` value (default auto)
  pager = true # colour when using pager (default true)
  # showBranch # colour in `git show`. Overrides `ui` value (default auto)
  # status # colour in `git status`. Overrides `ui` value (default auto)
  ui = auto # default colour mode for all the color options

[color "branch"]
  current = yellow reverse
  local = yellow
  plain = red # other refs
  remote = green
  upstream = blue

[color "diff"]
  commit = yellow # commit hash header in `git show` / `git log -p`
  context = normal # unchanged context lines
  frag = cyan # hunk header (@@ … @@)
  func = magenta # function name shown alongside the hunk header
  old = red # removed lines
  oldMoved = magenta bold # removed line detected as moved (diff.colorMoved)
  oldMovedDimmed = magenta dim # dimmed half of a moved removal under the zebra scheme
  oldMovedAlternative = blue bold # second hue so adjacent moved blocks stay distinct
  oldMovedAlternativeDimmed = blue dim italic # italic survives terminals that ignore dim/faint
  meta = white # diff/index metadata lines
  new = green # added lines
  newMoved = cyan bold # added line detected as moved
  newMovedDimmed = cyan dim # dimmed half of a moved addition under the zebra scheme
  newMovedAlternative = yellow bold # second hue for adjacent moved blocks
  newMovedAlternativeDimmed = yellow dim italic # italic survives terminals that ignore dim/faint
  whitespace = red reverse # whitespace errors

[color "decorate"]
  branch = yellow
  HEAD = blue bold
  remoteBranch = green
  stash = red
  tag = cyan

[color "grep"]
  context = white
  filename = normal dim
  function = magenta
  linenumber = cyan
  # match # set both `matchContext` and `matchSelected` at the same time
  matchContext = yellow
  matchSelected = yellow reverse normal bold
  selected = normal
  separator = cyan

[color "interactive"]
  error = red bold
  header = yellow
  help = normal dim
  prompt = cyan

[color "status"]
  added = green
  branch = magenta bold
  changed = yellow
  header = white
  localBranch = yellow
  nobranch = red
  remoteBranch = green
  unmerged = magenta
  untracked = blue
  # updated # same as `added`

[column]
  ui = auto column nodense # output in columns when possible (default never column nodense)
  # branch # specify column behaviour on `git branch`. Overrides `ui`.
  # clean # specify column behaviour on `git clean -i`. Overrides `ui`.
  # status # specify column behaviour on `git status`. Overrides `ui`.
  # tag # specify column behaviour on `git tag`. Overrides `ui`.

[commit]
  cleanup = strip # clean whitespace and comments from messages
  gpgSign = true # sign all commits
  status = true # show commit status in message editor as a comment
  # template = ~/.gitmessage # path to template to be used in the commit message
  verbose = true # show diff as a comment in the message editor

[core]
  abbrev = auto # length to which object names are abbreviated
  # askPass # commands to ask for user/pass (default unset)
  attributesFile = ~/.gitattributes # global attributes file
  autocrlf = input # convert CRLF to LF on commit, no conversion on checkout
  # bare # not applicable to a global gitconfig, relates to repo type
  # bigFileThreshold # threshold upon which files are stored deflated
  checkStat = default # determines which stat fields to match
  commentChar = "#" # character to mark a comment (default #)
  # compression # 0..9, 0 = no compression, 9 = best compression of objects
  # createObject # how files are created depending on system/OS (default unset)
  # deltaBaseCacheLimit # max bytes to reserve for caching base objects
  # editor # unset — git falls back through $GIT_EDITOR, $VISUAL, $EDITOR
  eol = native # line ending on checkout (only applies when autocrlf is false)
  excludesFile = ~/.gitignore_global # global ignore file
  fileMode = true # honour the executable bit of the file mode (default true)
  # filesRefLockTimeout # ms to wait until retry locking a ref (default 100)
  # fsmonitor # command to track changed files since a specified time
  fsync = all # enable fsync() when writing object files (default false)
  # gitProxy # proxy command for git protocol
  hideDotFiles = dotGitOnly # Windows only - mark dotfiles as hidden (default dotGitOnly)
  hooksPath = ~/.githooks # global hooks directory
  ignoreCase = false # workarounds for case-insensitive filesystems
  ignoreStat = false # ignore stat of possibly changed files (default false)
  # logAllRefUpdates # not applicable to a global gitconfig, relates to reflog
  # looseCompression # like compression but for objects not in a pack file (default 1)
  # notesRef # path to notes when `git show --notes` (default refs/notes/commits)
  # packedGitLimit # max bytes to map simultaneously into memory
  # packedGitWindowSize # bytes/pack-file to map into memory
  # packedRefsTimeout # ms to wait until retry locking a packed ref (default 1000)
  pager = "if command -v delta >/dev/null 2>&1; then delta; else less -MR; fi" # delta if installed, else less (cross-platform)
  precomposeUnicode = true # prevent showing unicode filenames as untracked
  preferSymlinkRefs = false # prefer symlink refs instead of default symrefs
  preloadIndex = true # enable parallel index preload (default true)
  # protectHFS # protect `.git` paths on HFS -- better left unset
  # protectNTFS # prevent problematic paths on NTFS -- better left unset
  quotePath = false # prevent escaping unicode characters
  # repositoryFormatVersion # not applicable, relates to repo format/layout version
  safecrlf = true # check if converting CRLF is reversible
  # sharedRepository # not applicable, relates to repo read/write abilities
  # sparseCheckout # repo-level, only checks out parts of the repo
  splitIndex = false # don't use the split-index feature
  # sshCommand # proxy command to use instead of ssh
  symlinks = true # support symlinks (default true)
  trustctime = false # ignore ctime differences
  untrackedCache = true # speed up commands that determine untracked files
  warnAmbiguousRefs = true # warn about ambiguous ref names (default true)
  whitespace = space-before-tab,trailing-space # common whitespace problems to notice
  # worktree # not applicable to a global gitconfig, relates to repo

[credential]
  helper = osxkeychain # macOS keychain helper (NOTE: unavailable on Linux)
  useHttpPath = true # consider the URL "path" component for per-repo credentials

[credentialCache]
  ignoreSIGHUP = true # ignore SIGHUP instead of quitting

[diff]
  algorithm = histogram # histogram = patience + frequency heuristics; more readable diffs (was patience)
  autoRefreshIndex = true # refresh the index before diffing (default true)
  colorMoved = dimmed-zebra # colour moved lines distinctly (see --color-moved)
  colorMovedWS = allow-indentation-change # don't flag pure re-indentation as a moved block
  context = 3 # number of lines of context around diff (default 3)
  # dirstat
  # external
  # ignoreSubmodules
  # indentHeuristic
  # interHunkContext
  mnemonicPrefix = true # i/w/c/o prefixes (index/worktree/commit/object) instead of a/b
  # noprefix
  # orderFile
  renameLimit = 7000 # max files to consider for rename detection
  renames = copies # detect copies in addition to renames
  # statGraphWidth
  # submodule
  # suppressBlankEmpty
  # tool
  # wordRegex
  wsErrorHighlight = all # highlight whitespace errors in context, old, and new lines (not just new)

