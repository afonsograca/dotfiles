  diff = "if command -v delta >/dev/null 2>&1; then delta; elif command -v diff-highlight >/dev/null 2>&1; then diff-highlight | less -R; else less -MR; fi"
  log = "if command -v delta >/dev/null 2>&1; then delta; elif command -v diff-highlight >/dev/null 2>&1; then diff-highlight | less -R; else less -MR; fi"
  show = "if command -v delta >/dev/null 2>&1; then delta; elif command -v diff-highlight >/dev/null 2>&1; then diff-highlight | less -R; else less -MR; fi"

