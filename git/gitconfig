[merge]
  branchdesc = true # include branch description in merge messages (default false)
  conflictStyle = zdiff3 # show base in conflict blocks, hoisting common lines out of the conflict (better than diff3)
  defaultToUpstream = true # merge the configured upstream when no ref is given
  ff = true # allow fast-forward merges (default true)
  log = true # append shortlog of merged commits to the message (default false)
  renameLimit = 7000 # max files to consider for rename detection
  renormalize = true # re-normalize line endings during merge (default false)
  stat = true # show diffstat at the end of a merge (default true)
  # tool # no default to pin — leave unset so `git mergetool` auto-detects
  verbosity = 2 # merge output verbosity
  verifySignatures = false # do not require signed commits to merge

# [merge "<driver>"] # custom merge driver
