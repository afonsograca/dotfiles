##
## Shell aliases
##

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias -- -='cd -'

# BusyBox vi does not read ~/.vimrc
if command -v vim >/dev/null 2>&1; then
  alias vi='vim'
fi

# Network
alias myip='curl -s https://ipinfo.io/ip'

# macOS specific
if [[ "$OSTYPE" == "darwin"* ]]; then
  alias flushdns='sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder'
fi
