[difftool]
  prompt = false # do not prompt before each difftool invocation

# Structural diff via difftastic. Opt-in only — `git dft` / `git difftool -t difftastic`;
# inert until invoked, so it never breaks plain `git diff` on machines without `difft`.
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[fastimport]
  # unpackLimit # limit after which objects are stored as a pack. Defaults to `transfer.unpackLimit`

[fetch]
  fsckObjects = true # validate objects received on fetch; reject malformed/malicious ones
  output = full # format of the output (default full)
  prune = true # remove remote-tracking refs that no longer exist on the remote
  pruneTags = false # remove tags not present on the remote, even local ones
  recurseSubmodules = on-demand # strategy to recurse into submodules
  # unpackLimit # limit after which objects are stored as a pack. Defaults to `transfer.unpackLimit`

