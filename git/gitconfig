[pull]
  ff = only # only fast-forward on pull; refuse to create a merge commit
  octopus = octopus # default merge strategy when pulling multiple branches
  # rebase = merges # use rebase as a default for `git pull`
  twohead = ort # default merge strategy when pulling a single branch

[push]
  default = simple # push current branch to upstream of same name; refuse if names differ
  followTags = false # don't auto-push annotated tags (set true to opt in)
  gpgSign = if-asked # sign pushes only when the server advertises support
  # pushOption # extra options sent to the server's pre/post-receive hooks
  recurseSubmodules = check # abort push if any submodule commit isn't already on a remote
  autoSetupRemote = true # on push with no upstream, auto-create one at <remote>/<same-name>

[rebase]
  abbreviateCommands = false # print `pick` rather than `p` during interactive rebase
  autoSquash = true # reorder fixup!/squash! commits during rebase
  autoStash = true # stash uncommitted changes before rebasing
  instructionFormat = "%C(auto) %h %d %s" # commit list format during interactive rebase
  missingCommitsCheck = warn # warn if commits were dropped during rebase (default ignore)
  stat = true # show diffstat of the rebase changes
  updateRefs = true # auto-move any branches pointing at rebased commits (stacked branches)

[receive]
  fsckObjects = true # validate objects on receive (matters when pushing into a local repo)

